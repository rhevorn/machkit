    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit benötigt Zugriff auf Systemereignisse, um in macOS konfigurierte Anmeldeobjekte zu lesen und zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit needs access to System Events to read and remove login items configured in macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit necesita acceso a Eventos del Sistema para leer y eliminar los ítems de inicio configurados en macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit doit accéder aux événements système pour lire et supprimer les éléments d’ouverture configurés dans macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKitがmacOSに設定されたログイン項目を読み取り、削除するには、システムイベントへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit가 macOS에 구성된 로그인 항목을 읽고 제거하려면 시스템 이벤트에 접근해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MachKit precisa acessar os Eventos do Sistema para ler e remover itens de início configurados no macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit требуется доступ к системным событиям, чтобы читать и удалять объекты входа, настроенные в macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit 需要访问“系统事件”，以读取和移除你在 macOS 中配置的登录项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit 需要存取「系統事件」，以讀取和移除你在 macOS 中設定的登入項目。"
          }
        }
      }
    },
