      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der verbleibende Papierkorb von %@ wurde endgültig gelöscht. Der macOS-Hintergrunddatensatz verschwindet möglicherweise, nachdem Sie sich erneut angemeldet haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los restos de papelera de %@ se eliminaron permanentemente. Su registro de fondo de macOS puede desaparecer después de que inicie sesión nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
