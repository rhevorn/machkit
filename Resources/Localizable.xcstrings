    "Please use system settings or the associated application to disable extensions to avoid damaging signatures and automatic updates." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte verwenden Sie die Systemeinstellungen oder die zugehörige Anwendung, um Erweiterungen zu deaktivieren, um schädliche Signaturen und automatische Updates zu vermeiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice la configuración del sistema o la aplicación asociada para deshabilitar las extensiones y evitar dañar las firmas y las actualizaciones automáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez utiliser les paramètres système ou l'application associée pour désactiver les extensions afin d'éviter d'endommager les signatures et les mises à jour automatiques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名や自動更新の損傷を避けるために、システム設定または関連するアプリケーションを使用して拡張機能を無効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 및 자동 업데이트가 손상되는 것을 방지하려면 시스템 설정 또는 관련 응용 프로그램을 사용하여 확장 기능을 비활성화하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use as configurações do sistema ou o aplicativo associado para desativar as extensões e evitar danos às assinaturas e atualizações automáticas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте системные настройки или соответствующее приложение, чтобы отключить расширения, чтобы избежать повреждения подписей и автоматических обновлений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用扩展请使用系统设置或所属应用，避免破坏签名与自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用擴充請使用系統設定或所屬應用，避免破壞簽章與自動更新。"
          }
        }
      }
    },
