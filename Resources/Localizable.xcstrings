    "Large files do not equal garbage, they are only used to help you discover content taking up space." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Dateien sind nicht gleichbedeutend mit Müll, sie werden nur verwendet, um Ihnen dabei zu helfen, Inhalte zu erkennen, die Speicherplatz beanspruchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos grandes no son basura, solo se usan para ayudarte a descubrir contenido que ocupa espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers volumineux ne sont pas synonymes de déchets, ils sont uniquement utilisés pour vous aider à découvrir du contenu occupant de l'espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなファイルはゴミに等しいわけではなく、スペースを占有しているコンテンツを見つけるためにのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대용량 파일은 쓰레기와 같지 않으며 공간을 차지하는 콘텐츠를 찾는 데에만 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos grandes não são iguais a lixo, eles são usados apenas para ajudá-lo a descobrir conteúdo que ocupa espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие файлы не являются мусором, они используются только для того, чтобы помочь вам обнаружить контент, занимающий место."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大文件不等于垃圾，只用于帮助你发现占用空间的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大檔案不等於垃圾，只用來幫助你發現佔用空間的內容。"
          }
        }
      }
    },
    "Large files do not mean garbage, they are only used to understand the space occupied." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Dateien bedeuten keinen Müll, sie dienen nur dazu, den belegten Speicherplatz zu verstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos grandes no significan basura, solo se utilizan para comprender el espacio ocupado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gros fichiers ne signifient pas des déchets, ils servent uniquement à comprendre l'espace occupé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなファイルはゴミを意味するものではなく、占有スペースを把握するためにのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대용량 파일은 쓰레기를 의미하지 않으며, 차지하는 공간을 이해하는 데에만 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos grandes não significam lixo, eles servem apenas para entender o espaço ocupado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие файлы не означают мусор, они используются только для понимания занимаемого места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大文件不等于垃圾，仅用于了解空间占用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大檔案不等於垃圾，僅用於了解空間佔用。"
          }
        }
      }
    },
