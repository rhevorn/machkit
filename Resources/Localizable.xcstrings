    "Only apps owned by the current user can be quit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es können nur Apps beendet werden, die dem aktuellen Benutzer gehören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sólo se pueden cerrar las aplicaciones propiedad del usuario actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les applications appartenant à l'utilisateur actuel peuvent être fermées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のユーザーが所有するアプリのみを終了できます。"
