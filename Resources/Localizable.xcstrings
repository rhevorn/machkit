          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se utiliza para buscar cachés de aplicaciones y restos. Habilítelo manualmente en Configuración del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
