          }
        }
      }
    },
    "This removes all data saved by MachKit on this Mac and then quits the app. System files and scan targets are not deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle von MachKit auf diesem Mac gespeicherten Daten gelöscht und die App anschließend beendet. Systemdateien und Scan-Ziele werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los datos guardados por MachKit en este Mac y cierra la app. No se eliminan archivos del sistema ni objetivos de análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime toutes les données enregistrées par MachKit sur ce Mac, puis quitte l’app. Les fichiers système et les cibles d’analyse ne sont pas supprimés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac に MachKit が保存したすべてのデータを削除して、アプリを終了します。システムファイルとスキャン対象は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 MachKit가 저장한 모든 데이터를 삭제한 후 앱을 종료합니다. 시스템 파일과 검사 대상은 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todos os dados salvos pelo MachKit neste Mac e fecha o app. Arquivos do sistema e alvos de análise não são excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все данные, сохранённые MachKit на этом Mac, а затем завершит работу приложения. Системные файлы и объекты сканирования не удаляются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会移除 MachKit 在此 Mac 上保存的所有数据，然后退出应用。系统文件和扫描目标不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會移除 MachKit 在此 Mac 上儲存的所有資料，然後結束 App。系統檔案和掃描目標不會被刪除。"
          }
        }
      }
    },
