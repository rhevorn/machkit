          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот процесс невозможно завершить из MachKit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
