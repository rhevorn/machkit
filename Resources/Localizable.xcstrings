    "User-visible temporary files under the home folder. In-use temp files are skipped by age; confirm before removing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichtbare temporäre Dateien im Benutzerordner. Aktuell genutzte Dateien werden über das Alter ausgefiltert; vor dem Entfernen bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos temporales visibles en la carpeta de usuario. Los que están en uso se omiten por antigüedad; confirma antes de eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers temporaires visibles du dossier utilisateur. Ceux en cours d’utilisation sont exclus par l’âge ; confirmez avant suppression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダ内の一時ファイルです。使用中のものは経過日数で除外されます。削除前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더의 임시 파일입니다. 사용 중인 파일은 보관 기간으로 제외되며, 삭제 전 확인이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos temporários visíveis na pasta do usuário. Em uso são filtrados pela idade; confirme antes de remover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временные файлы в домашней папке. Используемые сейчас отфильтровываются по возрасту; подтвердите удаление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户主目录下可见的临时文件。仍在使用的会按天数过滤；删除前请确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
