          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно удалить элемент входа. Проверьте разрешения на автоматизацию или перейдите в настройки системы, чтобы удалить их вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
