    "Force quitting may discard unsaved work. Use it only for unresponsive apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erzwungene Beenden kann dazu führen, dass nicht gespeicherte Arbeit verworfen wird. Verwenden Sie es nur für nicht reagierende Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El abandono forzado puede descartar el trabajo no guardado. Úselo sólo para aplicaciones que no responden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fermeture forcée peut entraîner la suppression du travail non enregistré. Utilisez-le uniquement pour les applications qui ne répondent pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制終了すると、保存されていない作業が破棄される場合があります。応答しないアプリに対してのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강제 종료하면 저장되지 않은 작업이 삭제될 수 있습니다. 응답하지 않는 앱에만 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O encerramento forçado pode descartar o trabalho não salvo. Use-o apenas para aplicativos que não respondem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительное завершение может привести к потере несохраненной работы. Используйте его только для не отвечающих приложений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制退出可能造成未保存内容丢失，只应用于无响应的 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制退出可能造成未保存内容丢失，只应用于无响应的 App。"
          }
        }
      }
