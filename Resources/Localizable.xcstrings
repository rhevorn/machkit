          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть можно только приложения, принадлежащие текущему пользователю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能退出当前用户的 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能退出目前使用者的 App。"
          }
        }
      }
    },
    "Only confirmed app remnants in the current user's Trash can be removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
