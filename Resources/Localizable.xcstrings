    "This shortcut is already used by macOS or another app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Tastenkürzel wird bereits von macOS oder einer anderen App verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este atajo ya lo usa macOS u otra app."
