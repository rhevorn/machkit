    "Use memory pressure and swap usage to decide whether action is needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie den Speicherdruck und die Swap-Nutzung, um zu entscheiden, ob Maßnahmen erforderlich sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
