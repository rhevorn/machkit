    "%@'s launch configuration was moved to Trash. Its current process may continue until it exits or the Mac restarts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Startkonfiguration von %@ wurde in den Papierkorb verschoben. Der aktuelle Prozess wird möglicherweise fortgesetzt, bis er beendet wird oder der Mac neu startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de inicio de %@ se movió a la Papelera. Su proceso actual puede continuar hasta que salga o se reinicie la Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de lancement de %@ a été déplacée vers la corbeille. Son processus actuel peut continuer jusqu'à ce qu'il se termine ou que le Mac redémarre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の起動構成はゴミ箱に移動されました。現在のプロセスは、終了するか Mac が再起動するまで続行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 실행 구성이 휴지통으로 이동되었습니다. 현재 프로세스는 종료되거나 Mac이 재시동될 때까지 계속될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração de inicialização do %@ foi movida para a Lixeira. Seu processo atual pode continuar até que ele seja encerrado ou o Mac seja reiniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурация запуска %@ была перенесена в корзину. Текущий процесс может продолжаться до тех пор, пока он не завершится или Mac не перезапустится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已将 %@ 的启动配置移入废纸篓；当前进程可能会继续运行到退出或重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已將 %@ 的啟動配置移入廢紙簍；當前進程可能會繼續運行到退出或重新啟動。"
          }
        }
      }
    },
    "%@'s Trash leftover was permanently deleted. Its macOS background record may disappear after you sign in again." : {
