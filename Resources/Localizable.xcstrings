    "Allows protected user folders to be scanned. File contents are never uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht das Scannen geschützter Benutzerordner. Dateiinhalte werden niemals hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite escanear carpetas de usuarios protegidas. El contenido del archivo nunca se carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet d'analyser les dossiers utilisateur protégés. Le contenu du fichier n'est jamais téléchargé."
          }
