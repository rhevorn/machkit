          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 후 자동으로 열리는 앱이 여기에 표시됩니다. 일부 새 항목은 시스템 설정에서만 관리할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
