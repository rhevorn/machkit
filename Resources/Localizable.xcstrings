      }
    },
    "A system proxy is enabled. Route lookup shows the Mac's outbound route; proxied apps connect to the local proxy first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Systemproxy ist aktiv. Die Routensuche zeigt den Ausgangspfad des Macs; Apps mit Proxy verbinden sich zuerst mit dem lokalen Proxy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un proxy del sistema activo. La consulta de ruta muestra la salida del Mac; las apps con proxy se conectan primero al proxy local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proxy système est activé. La recherche d’itinéraire affiche la sortie du Mac ; les apps utilisant le proxy se connectent d’abord au proxy local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムプロキシが有効です。経路検索には Mac の外向き経路が表示され、プロキシを使うアプリは先にローカルプロキシへ接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 프록시가 활성화되어 있습니다. 경로 조회는 Mac의 외부 경로를 표시하며, 프록시 앱은 먼저 로컬 프록시에 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um proxy do sistema está ativo. A consulta de rota mostra a saída do Mac; apps com proxy se conectam primeiro ao proxy local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён системный прокси. Поиск маршрута показывает выходной маршрут Mac; приложения с прокси сначала подключаются к локальному прокси."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已启用系统代理。路由查询显示 Mac 的出口路由；使用代理的 App 会先连接本地代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用系統代理。路由查詢顯示 Mac 的出口路由；使用代理的 App 會先連接本機代理。"
          }
        }
      }
    },
    "A VPN or TUN interface is active. Some destinations may bypass the default interface through more specific routes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine VPN- oder TUN-Schnittstelle ist aktiv. Einige Ziele können die Standardschnittstelle über spezifischere Routen umgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una interfaz VPN o TUN activa. Algunos destinos pueden omitir la interfaz predeterminada mediante rutas más específicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une interface VPN ou TUN est active. Certaines destinations peuvent contourner l’interface par défaut via des routes plus spécifiques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN または TUN インターフェイスが有効です。一部の宛先は、より優先度の高い経路でデフォルトインターフェイスを迂回する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 또는 TUN 인터페이스가 활성 상태입니다. 일부 대상은 더 구체적인 경로를 통해 기본 인터페이스를 우회할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma interface VPN ou TUN está ativa. Alguns destinos podem ignorar a interface padrão por rotas mais específicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активен интерфейс VPN или TUN. Некоторые адреса могут обходить интерфейс по умолчанию по более точным маршрутам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 或 TUN 接口处于活动状态。部分目标可能通过更具体的路由绕过默认接口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 或 TUN 介面處於活動狀態。部分目的地可能透過更明確的路由繞過預設介面。"
          }
        }
      }
    },
