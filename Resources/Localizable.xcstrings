        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 압력과 스왑 사용량을 사용하여 조치가 필요한지 여부를 결정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
