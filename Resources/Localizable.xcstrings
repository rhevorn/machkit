    "%@ “%@” will be moved to Trash. Its features will no longer load after you sign in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ „%@“ wird in den Papierkorb verschoben. Die Funktionen werden nicht mehr geladen, nachdem Sie sich erneut angemeldet haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ “%@” se moverá a la Papelera. Sus funciones ya no se cargarán después de que inicies sesión nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ « %@ » sera déplacé vers la corbeille. Ses fonctionnalités ne se chargeront plus après votre nouvelle connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 「%@」はゴミ箱に移動されます。再度サインインすると、その機能は読み込まれなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ '%@'은 휴지통으로 이동됩니다. 다시 로그인하면 해당 기능이 더 이상 로드되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ “%@” será movido para a Lixeira. Seus recursos não serão mais carregados depois que você fizer login novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ «%@» будет перемещено в корзину. Его функции больше не будут загружаться после повторного входа в систему."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@“%@”将移入废纸篓，重新登录后相关功能将不再加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@「%@」將移入廢紙簍，重新登入後相關功能將不再載入。"
          }
        }
      }
    },
    "%@ “%@” will be removed from Login Items. App files will not be deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ „%@“ wird aus den Anmeldeobjekten entfernt. App-Dateien werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ “%@” se eliminará de los elementos de inicio de sesión. Los archivos de la aplicación no se eliminarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ « %@ » sera supprimé des éléments de connexion. Les fichiers d'application ne seront pas supprimés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ログイン項目から「%@」が削除されます。アプリのファイルは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ \"%@\"이 로그인 항목에서 제거됩니다. 앱 파일은 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ “%@” será removido dos itens de login. Os arquivos do aplicativo não serão excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ «%@» будет удален из элементов входа. Файлы приложения не будут удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@“%@”将从登录项中移除，此操作不会删除应用文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@“%@”將從登錄項目中移除，此操作不會刪除應用程式檔案。"
          }
        }
      }
    },
    "%@ “%@”'s launch configuration will be moved to Trash. Running processes will not be terminated." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die Startkonfiguration von „%@“ wird in den Papierkorb verschoben. Laufende Prozesse werden nicht beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La configuración de inicio de “%@” se moverá a la Papelera. Los procesos en ejecución no finalizarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de lancement de %@ « %@ » sera déplacée vers la corbeille. Les processus en cours ne seront pas terminés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 「%@」の起動設定はゴミ箱に移動されます。実行中のプロセスは終了しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ '%@'의 실행 구성이 휴지통으로 이동됩니다. 실행 중인 프로세스는 종료되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração de inicialização de %@ “%@” será movida para a Lixeira. Os processos em execução não serão encerrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Конфигурация запуска «%@» будет перемещена в корзину. Запущенные процессы не будут прекращены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@“%@”的启动配置将移入废纸篓；已运行的进程不会被强制终止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@“%@”的啟動配置將移入廢紙簍；已運行的進程不會被強制終止。"
          }
        }
      }
    },
    "%@ (PID %d) is using %@ %@:%@. Graceful quit is safer; use force quit only if the process is unresponsive." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) verwendet %@ %@:%@. Ein würdevoller Ausstieg ist sicherer; Verwenden Sie „Force Quit“ nur, wenn der Prozess nicht reagiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) está utilizando %@ %@:%@. Dejar de fumar con elegancia es más seguro; use forzar el cierre solo si el proceso no responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) utilise %@ %@:%@. Un arrêt progressif est plus sûr ; n'utilisez la force d'arrêt que si le processus ne répond pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) は %@ %@:%@ を使用しています。正常に終了する方が安全です。プロセスが応答しない場合にのみ強制終了を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(PID %d)은 %@ %@:%@를 사용하고 있습니다. 우아하게 종료하는 것이 더 안전합니다. 프로세스가 응답하지 않는 경우에만 강제 종료를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) está usando %@ %@:%@. A saída elegante é mais segura; use forçar o encerramento somente se o processo não responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (PID %d) использует %@ %@:%@. Грациозный выход безопаснее; используйте принудительное завершение только в том случае, если процесс не отвечает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（PID %d）正在占用 %@ %@:%@。正常结束更安全；只有进程无响应时才使用强制结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（PID %d）正在佔用 %@ %@:%@。正常結束比較安全；只有在進程無回應時才使用強制結束。"
          }
        }
      }
    },
