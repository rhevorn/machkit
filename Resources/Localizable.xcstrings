    "Cannot remove login item. Please check automation permissions, or go to system settings to remove manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldeelement kann nicht entfernt werden. Bitte überprüfen Sie die Automatisierungsberechtigungen oder gehen Sie zu den Systemeinstellungen, um sie manuell zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede eliminar el elemento de inicio de sesión. Verifique los permisos de automatización o vaya a la configuración del sistema para eliminarlos manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer l'élément de connexion. Veuillez vérifier les autorisations d'automatisation ou accéder aux paramètres système pour les supprimer manuellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン項目を削除できません。自動化の許可を確認するか、システム設定に移動して手動で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 항목을 제거할 수 없습니다. 자동화 권한을 확인하거나 시스템 설정으로 이동하여 수동으로 제거하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível remover o item de login. Verifique as permissões de automação ou acesse as configurações do sistema para remover manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно удалить элемент входа. Проверьте разрешения на автоматизацию или перейдите в настройки системы, чтобы удалить их вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除登录项。请检查自动化权限，或前往系统设置手动移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法移除登入項目。請檢查自動化權限，或前往系統設定手動移除。"
          }
        }
      }
    },
