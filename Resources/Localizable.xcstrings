    "The background task database was rebuilt. Restart your Mac so valid items can register again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaufgabendatenbank wurde neu erstellt. Starten Sie Ihren Mac neu, damit gültige Artikel erneut registriert werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reconstruyó la base de datos de tareas en segundo plano. Reinicie su Mac para que los elementos válidos puedan registrarse nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données des tâches en arrière-plan a été reconstruite. Redémarrez votre Mac pour que les éléments valides puissent s'enregistrer à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド タスク データベースが再構築されました。有効なアイテムを再度登録できるように Mac を再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 작업 데이터베이스가 재구축되었습니다. 유효한 항목이 다시 등록될 수 있도록 Mac을 재시동하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O banco de dados de tarefas em segundo plano foi reconstruído. Reinicie o seu Mac para que itens válidos possam ser registrados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База данных фоновых задач была перестроена. Перезагрузите свой Mac, чтобы действительные элементы могли быть зарегистрированы снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台任务数据库已重建。请重启 Mac，让系统重新登记仍然有效的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
