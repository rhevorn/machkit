    "Language changes apply immediately without losing scan results or selections." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachänderungen werden sofort wirksam, ohne dass Scanergebnisse oder Auswahlen verloren gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de idioma se aplican inmediatamente sin perder los resultados o las selecciones del escaneo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements de langue s'appliquent immédiatement sans perdre les résultats d'analyse ou les sélections."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の変更は、スキャン結果や選択内容を失うことなく、すぐに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 결과나 선택 항목의 손실 없이 언어 변경 사항이 즉시 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações de idioma são aplicadas imediatamente, sem perder os resultados da verificação ou as seleções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения языка применяются немедленно без потери результатов сканирования или выбора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言切换会立即应用，当前扫描结果和选择不会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語言切換會立即套用，目前掃描結果和選擇不會遺失。"
          }
        }
      }
    },
    "Large Files" : {
      "extractionState" : "manual",
      "localizations" : {
