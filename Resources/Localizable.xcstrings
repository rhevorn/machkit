    "Wait for the app to finish saving, or force quit only if it is unresponsive." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis die App den Speichervorgang abgeschlossen hat, oder erzwingen Sie das Beenden nur, wenn sie nicht reagiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a que la aplicación termine de guardarse o fuerce el cierre solo si no responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que l'application ait fini de sauvegarder ou forcez sa fermeture uniquement si elle ne répond pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの保存が完了するまで待つか、アプリが応答しない場合にのみ強制終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 저장이 완료될 때까지 기다리거나, 응답이 없는 경우에만 강제 종료하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde até que o aplicativo termine de salvar ou force o encerramento somente se ele não responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подождите, пока приложение завершит сохранение, или принудительно закройте его, только если оно не отвечает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以等待 App 完成保存，或者仅在它无响应时强制退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以等待 App 完成儲存，或僅在它無回應時強制退出。"
          }
        }
      }
    },
