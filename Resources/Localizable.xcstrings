    "Unable to read macOS background task database. You can refresh and authorize it again, or view it directly in the system settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaufgabendatenbank von macOS kann nicht gelesen werden. Sie können es erneut aktualisieren und autorisieren oder direkt in den Systemeinstellungen anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la base de datos de tareas en segundo plano de macOS. Puede actualizarlo y autorizarlo nuevamente, o verlo directamente en la configuración del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire la base de données des tâches en arrière-plan macOS. Vous pouvez l'actualiser et l'autoriser à nouveau, ou le visualiser directement dans les paramètres système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS バックグラウンド タスク データベースを読み取ることができません。更新して再度認証することも、システム設定で直接表示することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 백그라운드 작업 데이터베이스를 읽을 수 없습니다. 새로고침하여 다시 승인하거나 시스템 설정에서 직접 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler o banco de dados de tarefas em segundo plano do macOS. Você pode atualizá-lo e autorizá-lo novamente ou visualizá-lo diretamente nas configurações do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно прочитать базу данных фоновых задач macOS. Вы можете обновить и авторизовать его еще раз или просмотреть непосредственно в настройках системы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 macOS 后台任务数据库。可以重新刷新并授权，或直接在系统设置中查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 macOS 後台任務資料庫。可以重新刷新並授權，或直接在系統設定中查看。"
          }
        }
      }
    },
    "Unable to read macOS login items. Please allow MachKit to control System Events in system settings, or manage it directly in system settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-Anmeldeelemente können nicht gelesen werden. Bitte erlauben Sie MachKit, Systemereignisse in den Systemeinstellungen zu steuern, oder verwalten Sie sie direkt in den Systemeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer los elementos de inicio de sesión de macOS. Permita que MachKit controle los eventos del sistema en la configuración del sistema o adminístrelo directamente en la configuración del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les éléments de connexion macOS. Veuillez autoriser MachKit à contrôler les événements système dans les paramètres système, ou à les gérer directement dans les paramètres système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS のログイン項目を読み取ることができません。 MachKit がシステム設定でシステム イベントを制御できるようにするか、システム設定で直接管理できるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 로그인 항목을 읽을 수 없습니다. MachKit가 시스템 설정에서 시스템 이벤트를 제어하도록 허용하거나 시스템 설정에서 직접 관리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler os itens de login do macOS. Permita que o MachKit controle os eventos do sistema nas configurações do sistema ou gerencie-os diretamente nas configurações do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно прочитать элементы входа в macOS. Разрешите MachKit контролировать системные события в настройках системы или управлять ими непосредственно в настройках системы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 macOS 登录项。请在系统设置中允许 MachKit 控制“系统事件”，或直接在系统设置中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 macOS 登入項目。請在系統設定中允許 MachKit 控制“系統事件”，或直接在系統設定中管理。"
          }
        }
      }
    },
