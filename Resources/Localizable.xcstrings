        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit kann seinen eigenen Prozess nicht beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit no puede abandonar su propio proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MachKit ne peut pas quitter son propre processus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift 自体のプロセスを終了することはできません。"
