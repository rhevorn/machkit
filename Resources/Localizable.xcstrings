    "Simulator device data that Xcode reports as unavailable (usually after a runtime was removed). Active simulators are left alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulator-Gerätedaten, die Xcode als nicht verfügbar meldet (meist nach Entfernen einer Runtime). Aktive Simulatoren bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de dispositivos del simulador que Xcode marca como no disponibles (suele ocurrir tras quitar un runtime). Los simuladores activos no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données d’appareils simulateur signalées indisponibles par Xcode (souvent après suppression d’un runtime). Les simulateurs actifs restent intacts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode が利用不可と報告するシミュレータデバイスデータです（ランタイム削除後など）。利用中のシミュレータには触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode가 사용 불가로 표시한 시뮬레이터 기기 데이터입니다(런타임 제거 후 등). 활성 시뮬레이터는 그대로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de dispositivos do simulador que o Xcode marca como indisponíveis (geralmente após remover um runtime). Simuladores ativos não são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные устройств симулятора, которые Xcode считает недоступными (часто после удаления runtime). Активные симуляторы не затрагиваются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 标记为不可用的模拟器设备数据（常见于删除运行时之后）。不会动仍可用的模拟器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 標記為無法使用的模擬器裝置資料（常見於刪除執行環境之後）。不會動仍可用的模擬器。"
          }
        }
      }
    },
