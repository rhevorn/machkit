    "The app and selected related files will be moved to Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App und ausgewählte zugehörige Dateien werden in den Papierkorb verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación y los archivos relacionados seleccionados se moverán a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application et les fichiers associés sélectionnés seront déplacés vers la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリと選択した関連ファイルはゴミ箱に移動されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱과 선택한 관련 파일이 휴지통으로 이동됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo e os arquivos relacionados selecionados serão movidos para a Lixeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение и выбранные связанные файлы будут перемещены в корзину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序和已勾选的关联文件都会移入废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式和已勾選的關聯文件都會移入廢紙簍。"
          }
        }
      }
    },
    "The app identity could not be verified, so the app will not be quit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Identität konnte nicht überprüft werden, daher wird die App nicht beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar la identidad de la aplicación, por lo que no se cerrará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identité de l'application n'a pas pu être vérifiée, l'application ne sera donc pas fermée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの ID を確認できなかったため、アプリは終了されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 신원을 확인할 수 없어 앱이 종료되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade do aplicativo não pôde ser verificada, portanto o aplicativo não será encerrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить личность приложения, поэтому приложение не будет закрыто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认 App 身份，不会退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认 App 身份，不会退出。"
          }
        }
      }
    },
    "The app leftover in Trash will be permanently deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die im Papierkorb verbleibende App wird dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación que quede en la Papelera se eliminará permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application restante dans la corbeille sera définitivement supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱に残ったアプリは完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
