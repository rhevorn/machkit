          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロセスは MachKit から終了できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로세스는 MachKit에서 종료할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
