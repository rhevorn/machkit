    "Apps that open automatically after logging in are displayed here; some new items can only be managed in system settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier werden Apps angezeigt, die sich nach der Anmeldung automatisch öffnen; Einige neue Elemente können nur in den Systemeinstellungen verwaltet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí se muestran las aplicaciones que se abren automáticamente después de iniciar sesión; Algunos elementos nuevos solo se pueden administrar en la configuración del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications qui s'ouvrent automatiquement après la connexion sont affichées ici ; certains nouveaux éléments ne peuvent être gérés que dans les paramètres système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
