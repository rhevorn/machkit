    "%@'s launch configuration was moved to Trash. Its current process may continue until it exits or the Mac restarts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Startkonfiguration von %@ wurde in den Papierkorb verschoben. Der aktuelle Prozess wird möglicherweise fortgesetzt, bis er beendet wird oder der Mac neu startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de inicio de %@ se movió a la Papelera. Su proceso actual puede continuar hasta que salga o se reinicie la Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de lancement de %@ a été déplacée vers la corbeille. Son processus actuel peut continuer jusqu'à ce qu'il se termine ou que le Mac redémarre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の起動構成はゴミ箱に移動されました。現在のプロセスは、終了するか Mac が再起動するまで続行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 실행 구성이 휴지통으로 이동되었습니다. 현재 프로세스는 종료되거나 Mac이 재시동될 때까지 계속될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração de inicialização do %@ foi movida para a Lixeira. Seu processo atual pode continuar até que ele seja encerrado ou o Mac seja reiniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурация запуска %@ была перенесена в корзину. Текущий процесс может продолжаться до тех пор, пока он не завершится или Mac не перезапустится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已将 %@ 的启动配置移入废纸篓；当前进程可能会继续运行到退出或重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已將 %@ 的啟動配置移入廢紙簍；當前進程可能會繼續運行到退出或重新啟動。"
          }
        }
      }
    },
    "%@'s Trash leftover was permanently deleted. Its macOS background record may disappear after you sign in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der verbleibende Papierkorb von %@ wurde endgültig gelöscht. Der macOS-Hintergrunddatensatz verschwindet möglicherweise, nachdem Sie sich erneut angemeldet haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los restos de papelera de %@ se eliminaron permanentemente. Su registro de fondo de macOS puede desaparecer después de que inicie sesión nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les restes de la corbeille du %@ ont été définitivement supprimés. Son enregistrement d'arrière-plan macOS peut disparaître après votre nouvelle connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のゴミ箱の残りは完全に削除されました。再度サインインすると、macOS バックグラウンド レコードが消える場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님의 남은 휴지통이 영구 삭제되었습니다. 다시 로그인하면 macOS 배경 기록이 사라질 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sobras da Lixeira de %@ foram excluídas permanentemente. O registro em segundo plano do macOS pode desaparecer depois que você fizer login novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остатки корзины пользователя %@ были окончательно удалены. Его фоновая запись macOS может исчезнуть после повторного входа в систему."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已永久删除 %@ 的废纸篓残留；macOS 后台记录可能在重新登录后消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
