    "Only identifier-based caches, preferences, saved state, logs, and sandbox containers are checked." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geprüft werden nur kennungsbasierte Caches, Einstellungen, gespeicherte Zustände, Protokolle und Sandbox-Container."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comprueban cachés, preferencias, estados guardados, registros y contenedores de sandbox basados en identificadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les caches, préférences, états enregistrés, journaux et conteneurs sandbox basés sur un identifiant sont vérifiés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "識別子ベースのキャッシュ、環境設定、保存状態、ログ、サンドボックスコンテナのみを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식별자 기반 캐시, 환경설정, 저장 상태, 로그 및 샌드박스 컨테이너만 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas caches, preferências, estados salvos, logs e contêineres de sandbox baseados em identificadores são verificados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяются только кэши, настройки, сохранённые состояния, журналы и контейнеры песочницы с идентификаторами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅检查以 App 标识符命名的缓存、偏好设置、保存状态、日志和沙盒容器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅檢查以 App 識別碼命名的快取、偏好設定、儲存狀態、日誌和沙盒容器。"
          }
        }
      }
    },
